# ===================================================================
# Azora Buildspaces - Canonical Environment Template
# Copy to .env.local and set values for your environment.
# ===================================================================

# -------------------------------------------------------------------
# Core App
# -------------------------------------------------------------------
NODE_ENV=development
BUILDSPACES_PORT=3002
BUILDSPACES_ENV=development
PORT=3000
BUILDSPACES_DEBUG=false
BUILDSPACES_LOG_LEVEL=info
PROJECT_ROOT=
npm_package_version=

# -------------------------------------------------------------------
# Auth (required)
# -------------------------------------------------------------------
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3002
NEXTAUTH_URL_INTERNAL=http://localhost:3002
# Optional: leave empty to reuse NEXTAUTH_SECRET
JWT_SECRET=
DEV_AUTH_EMAIL=admin@azora.world
DEV_AUTH_PASSWORD=Azora2026!
GITHUB_ID=
GITHUB_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional auth feature gates
AUTH_PASSWORD_RESET_ENABLED=false
AUTH_EMAIL_VERIFICATION_ENABLED=false
AUTH_FAILED_LOGIN_THRESHOLD=5
AUTH_FAILED_LOGIN_WINDOW_MS=900000
AUTH_MULTI_IP_THRESHOLD=3
AUTH_MULTI_IP_WINDOW_MS=300000

# -------------------------------------------------------------------
# Database / Cache
# -------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:password@localhost:5432/azora_buildspaces
DIRECT_URL=
DATABASE_POOL_SIZE=20
USE_POSTGRES=true

REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
USE_REDIS=false

# -------------------------------------------------------------------
# AI Providers
# -------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_ORG_ID=
OPENAI_MODEL=gpt-4o
ANTHROPIC_API_KEY=
LOCAL_LLM_MODEL=
LOCAL_LLM_API_URL=
# Command Desk uses LOCAL_LLM_API_URL when model "Mistral 7B" is selected.
# Set LOCAL_LLM_MODEL to your Mistral model id if your endpoint requires it.
AZORA_AI_KEY=
ELEVENLABS_API_KEY=

# Code Chamber provider switch
CODE_CHAMBER_PROVIDER=openai
CITADELSM_ENDPOINT=https://localhost:8000/citadelsm
CITADELSG_ENDPOINT=https://localhost:8001/citadelsg
API_KEY=

# -------------------------------------------------------------------
# Internal Service Integrations
# -------------------------------------------------------------------
AI_FAMILY_URL=http://localhost:3005
AI_FAMILY_API_KEY=
KNOWLEDGE_OCEAN_URL=http://localhost:3006
KNOWLEDGE_OCEAN_API_KEY=
ELARA_ORCHESTRATOR_URL=http://localhost:3010/agent/prompt
AZORA_ENCRYPTION_KEY=
AZORA_PILOT_AUTOMATIC_INGEST=false

# -------------------------------------------------------------------
# Execution / Runtime Backends
# -------------------------------------------------------------------
WORKSPACE_COMMANDS_ENABLED=false
DAP_BACKEND_ENABLED=false
NEXT_PUBLIC_DAP_BACKEND_ENABLED=false
LSP_BACKEND_ENABLED=false
GIT_BACKEND_ENABLED=false
PREBUILD_EXECUTOR_ENABLED=false

# Terminal
TERMINAL_BRIDGE_URL=http://localhost:3010
NEXT_PUBLIC_TERMINAL_ENABLED=false
NEXT_PUBLIC_TERMINAL_HOST=localhost:3001

# Notebook
NEXT_PUBLIC_NOTEBOOK_ENABLED=false
NOTEBOOK_EXECUTOR_URL=

# Telemetry sink
TELEMETRY_ENDPOINT_URL=

# -------------------------------------------------------------------
# Design / Collaboration Integrations
# -------------------------------------------------------------------
FIGMA_TOKEN=
NEXT_PUBLIC_FIGMA_ENABLED=false

# -------------------------------------------------------------------
# Web3 / Blockchain
# -------------------------------------------------------------------
ETHEREUM_RPC_URL=
SOLANA_RPC_URL=
WEB3_DEPLOY_ADAPTER=
WEB3_LOCAL_RPC_URL=http://127.0.0.1:8545
WEB3_BRIDGE_URL=http://localhost:3010

AZR_MINT_ENABLED=false
AZR_TOTAL_SUPPLY=1000000000
AZR_CHAIN=ethereum
AZR_CONTRACT_ADDRESS=

# -------------------------------------------------------------------
# CI/CD and Deployment Provider Secrets
# -------------------------------------------------------------------
VERCEL_TOKEN=
NETLIFY_AUTH_TOKEN=
CLOUDFLARE_API_TOKEN=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
FIREBASE_TOKEN=
FLY_API_TOKEN=
RAILWAY_TOKEN=
RENDER_API_KEY=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=
PISTON_API_URL=https://emkc.org/api/v2/piston

# -------------------------------------------------------------------
# GitHub Integration
# -------------------------------------------------------------------
GITHUB_TOKEN=
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
SSH_KEY_PATH=

# -------------------------------------------------------------------
# Payments
# -------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# -------------------------------------------------------------------
# Feature Flags
# -------------------------------------------------------------------
SANDBOX_ENABLED=true
ENABLE_WEBSOCKET_COLLABORATION=true
ENABLE_CONSTITUTIONAL_GATES=true
ENABLE_AGENT_EXECUTION=true

ENABLE_CODE_CHAMBER=true
ENABLE_SPEC_CHAMBER=true
ENABLE_DESIGN_STUDIO=true
ENABLE_AI_STUDIO=true
ENABLE_COMMAND_DESK=true
ENABLE_MAKER_LAB=true
ENABLE_COLLABORATION_POD=true
ENABLE_COLLECTIBLE_SHOWCASE=true

NEXT_PUBLIC_AGENT_API_URL=/api/agents/invoke
NEXT_PUBLIC_EXTERNAL_LLM_ENABLED=false
NEXT_PUBLIC_EXTERNAL_LLM_PROVIDER=openai
NEXT_PUBLIC_PREDAI_API_URL=http://localhost:3015
NEXT_PUBLIC_PREVIEW_URL=http://localhost:3000

# -------------------------------------------------------------------
# Agent Runtime Tuning
# -------------------------------------------------------------------
AGENT_TIMEOUT_MS=60000
AGENT_MAX_RETRIES=3
AGENT_COST_THRESHOLD_CENTS=500
TRACK_AGENT_METRICS=true

# -------------------------------------------------------------------
# Observability / Logging
# -------------------------------------------------------------------
PROMETHEUS_ENABLED=false
PROMETHEUS_PORT=9090
METRICS_SCRAPE_INTERVAL=15s

LOG_FORMAT=json
LOG_LEVEL=info
LOG_SERVICE_NAME=buildspaces
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_VERCEL_GIT_COMMIT_SHA=

OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=

# -------------------------------------------------------------------
# API Gateway / Security
# -------------------------------------------------------------------
API_GATEWAY_URL=http://localhost:3000/api
INTERNAL_API_URL=http://localhost:3000

VAULT_ADDR=
VAULT_TOKEN=
CONSTITUTIONAL_PROFILE=STANDARD

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=1000
CORS_ORIGIN=http://localhost:3002,http://localhost:3000

# -------------------------------------------------------------------
# Collaboration
# -------------------------------------------------------------------
NEXT_PUBLIC_WS_URL=ws://localhost:1234
NEXT_PUBLIC_COLLAB_WS_URL=ws://localhost:1234
NEXT_PUBLIC_COLLAB_SIGNALING_URL=ws://localhost:4444
COLLAB_WEBHOOK_URL=

# -------------------------------------------------------------------
# Admin Bootstrap
# -------------------------------------------------------------------
ADMIN_EMAIL=admin@azora.world
ADMIN_PASSWORD=Azora2026!

# -------------------------------------------------------------------
# Dev Settings
# -------------------------------------------------------------------
NEXT_PUBLIC_DEBUG=false
NEXT_PUBLIC_MOCKING=false
TURBO_SKIP_PRUNE=true
